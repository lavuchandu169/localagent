{
  "name": "localagent",
  "version": "0.1.0-beta.116",
  "description": "A local-first autonomous coding agent for macOS and Windows — bring your own model (embedded GGUF, Ollama/LM Studio/vLLM, Claude, OpenAI, Gemini, or a bundled free-tier router), with a real agent loop, permission engine, MCP tools, cross-provider fallback, and multi-session desktop UI.",
  "license": "UNLICENSED",
  "author": "Chandu Lavu",
  "repository": {
    "type": "git",
    "url": "https://github.com/lavuchandu169/localagent.git"
  },
  "type": "module",
  "main": "dist/electron/main.js",
  "bin": {
    "localagent": "./dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/verify-freellmapi-submodule.mjs && node scripts/generate-embedded-credentials.mjs && node scripts/generate-whats-new.mjs && node scripts/build-freellmapi.mjs && node scripts/generate-third-party-notices.mjs && tsc -p tsconfig.json && node scripts/copy-electron-assets.mjs",
    "start": "node dist/cli.js",
    "demo": "node dist/demo.js",
    "test": "node scripts/run-tests.mjs",
    "electron": "electron .",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "package:mac": "npm run build && npm run rebuild:native && electron-builder --mac",
    "package:win": "npm run build && npm run rebuild:native && electron-builder --win",
    "package:all": "npm run build && npm run rebuild:native && electron-builder -mw"
  },
  "build": {
    "appId": "com.chandulavu.localagent",
    "productName": "localagent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "THIRD-PARTY-NOTICES.md",
      "!dist/test/**",
      "!dist/demo.js",
      "!**/node_modules/@node-llama-cpp/*-cuda*/**",
      "!**/node_modules/@node-llama-cpp/win-arm64/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "src/electron/renderer/icon-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "win": {
      "icon": "src/electron/renderer/icon-512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "sign": "scripts/sign-windows.mjs"
      }
    },
    "publish": {
      "provider": "github",
      "releaseType": "prerelease"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.10.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "node-llama-cpp": "^3.20.0",
    "zod": "^3.25.0"
  },
  "overrides": {
    "proxy-addr": "2.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.14.9",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.2",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "^4.4.2",
    "typescript": "^5.5.4"
  }
}
